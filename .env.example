# MinIO connection
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=barktown

# Polling: how often to scan upload-here/ (ms)
POLL_INTERVAL_MS=20000

# How long a file must be stable (size+etag unchanged) before processing (ms)
STABILITY_DELAY_MS=30000

# Override if ffprobe / ffmpeg / audiowaveform are not on PATH for the service user
# FFPROBE_BIN=/usr/bin/ffprobe
# FFMPEG_BIN=/usr/bin/ffmpeg
# AUDIOWAVEFORM_BIN=/usr/bin/audiowaveform

# WAV-to-MP3 pre-processing applied to .wav files landing in upload-here/
# Volume boost: 200 = 2× amplitude (~6 dB louder). Set to 100 to disable boost.
# WAV_VOLUME_BOOST_PCT=200
# WAV_MP3_BITRATE=128

# ID3 tags embedded in every converted MP3.
# Year is derived automatically from the recording date.
# RECORDING_LOCATION=52.3676° N, 4.9041° E
# RECORDING_DIRECTION=facing north
# RECORDING_ARTIST=Your Name
# RECORDING_ALBUM=Barktown
# RECORDING_COPYRIGHT=© 2026 Your Name

# Base URL of the Barktown web app, embedded as a WOAF ID3 tag (Official Audio File Webpage).
# Opening the MP3 in a compatible player shows a clickable link to the recording entry.
# BARKTOWN_URL=https://barktown.enchart.me

# Min duration in seconds to generate a waveform (shorter = "note" entry)
# WAVEFORM_THRESHOLD_SEC=5

# Local SQLite database file — metadata store for training samples
# (source of truth; training-samples-index.json is regenerated from it)
# DB_PATH=./data/barktown.db

# Public read-only API (server.mjs) — publish this port through cloudflared
# PUBLIC_API_HOST=127.0.0.1
# PUBLIC_API_PORT=8091

# Private mutation/operator API (server-private.mjs) — Tailscale only
# Existing API_HOST/API_PORT values remain supported as fallbacks.
# PRIVATE_API_HOST=127.0.0.1
# PRIVATE_API_PORT=8090

# Re-analyze archived WAVs with the sibling barktown-goblin checkout.
# Point Python at the environment where Goblin's TFLite runtime is installed.
# REANALYZE_PYTHON_BIN=/opt/bark/venv/bin/python
# REANALYZE_SCRIPT_PATH=/opt/bark/barktown-goblin/tools/analyze_wav.py
# REANALYZE_MODEL_DIR=/opt/bark/barktown-goblin/models
# REANALYZE_TIMEOUT_MS=300000
# REANALYZE_MAX_STDOUT_BYTES=2097152
# REANALYZE_MAX_STDERR_BYTES=131072
# REANALYZE_CONCURRENCY=4
# BULK_REANALYZE_PUBLIC_API_URL=http://127.0.0.1:8091
# BULK_REANALYZE_PRIVATE_API_URL=http://127.0.0.1:8090
