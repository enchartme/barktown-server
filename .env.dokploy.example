# Use these as Dokploy Compose environment variables. Never commit real credentials.
# Prepare an existing directory with a test SQLite backup, owned by BARKTOWN_UID/GID.
BARKTOWN_DATA_DIR=/srv/verbatim/barktown-staging/data
BARKTOWN_IMAGE_TAG=staging
BARKTOWN_UID=1000
BARKTOWN_GID=1000
BARKTOWN_PRIVATE_HOST_PORT=28090
BARKTOWN_PUBLIC_HOST_PORT=28091

MINIO_ENDPOINT=host.docker.internal
MINIO_PORT=9000
MINIO_USE_SSL=false
# Use a separate test bucket, with credentials scoped to it.
MINIO_BUCKET=barktown-staging
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
# Read-only credentials for the public API.
PUBLIC_MINIO_ACCESS_KEY=
PUBLIC_MINIO_SECRET_KEY=
