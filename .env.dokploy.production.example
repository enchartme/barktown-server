# Paste into the production Compose app's Environment editor, with real values.
# Keep credentials in Dokploy and in a secure backup, never in Git.
BARKTOWN_DATA_DIR=/srv/verbatim/barktown/data
BARKTOWN_IMAGE_TAG=production
BARKTOWN_UID=1000
BARKTOWN_GID=1000
BARKTOWN_PRIVATE_HOST_PORT=8090
BARKTOWN_PUBLIC_HOST_PORT=8091

MINIO_ENDPOINT=host.docker.internal
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_BUCKET=barktown
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
# A separate read-only identity for the API's S3 ListObjects and HeadObject calls.
PUBLIC_MINIO_ACCESS_KEY=
PUBLIC_MINIO_SECRET_KEY=

# Copy your existing ingest and recording overrides here.
# POLL_INTERVAL_MS=20000
# STABILITY_DELAY_MS=30000
# WAV_VOLUME_BOOST_PCT=200
# WAV_MP3_BITRATE=128
# RECORDING_LOCATION=
# RECORDING_DIRECTION=
# RECORDING_ARTIST=
# RECORDING_ALBUM=
# RECORDING_COPYRIGHT=
# BARKTOWN_URL=https://barktown.enchart.me
# Goblin analyzer is a separate Dokploy Compose service on this private network.
# Deploy it first; no model/script mounts or Python environment are needed here.
REANALYZE_URL=http://barktown-analyzer:8080
REANALYZE_TIMEOUT_MS=330000
REANALYZE_CONCURRENCY=3
REANALYZE_WORKERS_PER_JOB=3
