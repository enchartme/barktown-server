{
  "name": "barktown-ingest",
  "version": "0.1.0",
  "private": true,
  "description": "Pi-side ingest service for barktown — watches MinIO /new/, validates filenames, generates waveforms, organises audio, updates index.json",
  "type": "module",
  "scripts": {
    "start": "node ingest-service.mjs",
    "server": "node server.mjs",
    "server:private": "node server-private.mjs",
    "serve": "sudo systemctl start barktown-ingest barktown-api barktown-api-private",
    "stop": "sudo systemctl stop barktown-api-private barktown-api barktown-ingest",
    "restart": "sudo systemctl restart barktown-ingest barktown-api barktown-api-private",
    "serve:ingest": "sudo systemctl start barktown-ingest",
    "serve:public": "sudo systemctl start barktown-api",
    "serve:private": "sudo systemctl start barktown-api-private",
    "stop:ingest": "sudo systemctl stop barktown-ingest",
    "stop:public": "sudo systemctl stop barktown-api",
    "stop:private": "sudo systemctl stop barktown-api-private",
    "restart:ingest": "sudo systemctl restart barktown-ingest",
    "restart:public": "sudo systemctl restart barktown-api",
    "restart:private": "sudo systemctl restart barktown-api-private",
    "validate-index": "node validate-index.mjs",
    "rebuild-index": "node rebuild-index.mjs",
    "rebuild-samples-index": "node rebuild-samples-index.mjs",
    "migrate-samples-to-sqlite": "node migrate-samples-to-sqlite.mjs",
    "migrate-diary": "node migrate-diary-to-sqlite.mjs",
    "dump-db": "node dump-db.mjs",
    "compare-index-with-list": "node compare-index-with-list.mjs",
    "check-sizes": "node check-sizes.mjs",
    "bulk-reanalyze": "node bulk-reanalyze.mjs",
    "observe": "journalctl -u barktown-ingest -f",
    "migrate-auto-detection-names": "node migrations/auto-detection-canonical-names/migrate-auto-detection-canonical-names.mjs",
    "test": "node --test test/*.test.mjs migrations/auto-detection-canonical-names/*.test.mjs"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "better-sqlite3": "^13.0.1",
    "fastify": "^5.10.0",
    "minio": "^8.0.7"
  },
  "engines": {
    "node": ">=18"
  },
  "allowScripts": {
    "better-sqlite3@13.0.1": true
  }
}
